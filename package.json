{
  "name": "agent-dashboard",
  "version": "1.1.1",
  "description": "Claude Code Agent Teams için canlı organizasyon şeması dashboard'u",
  "main": "main.js",
  "author": "Tuğrul Ceyhan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "simulate": "node tools/simulate.js",
    "status-server": "node tools/status-server.js",
    "dashboard-server": "node tools/dashboard-server.js",
    "icon": "node tools/make-icon.js",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.tugrul.agentdashboard",
    "productName": "Agent Dashboard",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "tools/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Dashboard"
    }
  }
}
